(version 1)
(allow default)
(deny network*)
(deny file-write*)
(allow file-write* (subpath "@WT@") (subpath "@S@/tmp") (subpath "/dev") (subpath "/private/tmp") (subpath "/private/var/folders"))
(deny file-read* (subpath "@H@"))
(allow file-read* (subpath "@WT@"))
(allow file-read-metadata (literal "@H@") (literal "@H@/.parallax") (literal "@H@/.parallax/m6a") (literal "@S@"))
