rules_version = '2';
// ════════════════════════════════════════════════════════════════════════
// PATH A (claims-based) Firestore rules — DO NOT DEPLOY TO PROD YET.
// Deploy ONLY to a staging/preview project (or emulator) for Phase 2 validation.
// Requires every client to hold a Firebase custom token with {orgId, role, athleteId}
// claims (minted server-side after the PIN/password check). Restores the full
// apex-athlete client data layer + real-time listeners, scoped per org/role.
// Cutover (Phase 3) replaces the live `organizations/** if false` with this.
// Galactik/command-center/meet blocks unchanged from the live canonical ruleset.
// ════════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    function authedOrg(orgId) { return request.auth != null && request.auth.token.orgId == orgId; }
    function isCoach(orgId)   { return authedOrg(orgId) && (request.auth.token.role == 'coach' || request.auth.token.role == 'admin'); }
    function isAthlete(id)    { return request.auth != null && request.auth.token.athleteId == id; }

    match /organizations/{orgId} {
      // Full roster carries minor PII (birthday, parentEmail) → coaches only.
      match /rosters/{doc}        { allow read, write: if isCoach(orgId); }
      match /config/{doc}         { allow read: if authedOrg(orgId); allow write: if isCoach(orgId); }
      match /schedules/{doc}      { allow read: if authedOrg(orgId); allow write: if isCoach(orgId); }
      match /audit/{doc}          { allow read, write: if isCoach(orgId); }
      match /snapshots/{doc}      { allow read, write: if isCoach(orgId); }
      match /feedback/{athleteId} { allow read: if isCoach(orgId) || isAthlete(athleteId); allow write: if isCoach(orgId); }
      match /wellness/{athleteId} { allow read, write: if isCoach(orgId) || isAthlete(athleteId); }
      match /athletes/{athleteId}/{document=**} {
        allow read, write: if isCoach(orgId) || isAthlete(athleteId);
      }
      // anything else under an org: coaches only
      match /{document=**}        { allow read, write: if isCoach(orgId); }
    }

    // ── Galactik (consumer) — unchanged from live canonical ─────────────
    match /users/{userId}            { allow read, write: if request.auth != null && request.auth.uid == userId; }
    match /users/{userId}/sync/{doc} { allow read, write: if request.auth != null && request.auth.uid == userId; }
    match /leaderboard/{userId}      { allow read: if true; allow write: if request.auth != null && request.auth.uid == userId; }
    match /characters/{charId}       { allow read: if true; allow write: if false; }
    match /planets/{planetId}        { allow read: if true; allow write: if false; }
    match /lore/{loreId}             { allow read: if true; allow write: if false; }
    match /commerceOrders/{sessionId}    { allow read, write: if false; }
    match /stripeWebhookEvents/{eventId} { allow read, write: if false; }

    // ── ramiche command center / Mettle public — unchanged ──────────────
    match /command-center/{document=**} { allow read, write: if false; }
    match /yolo_builds/{buildId}        { allow read, write: if false; }
    match /subscriptions/{doc}          { allow read, write: if false; }
    match /connectedAccounts/{doc}      { allow read, write: if false; }
    match /push_subscriptions/{id}      { allow read, write: if request.auth != null; }
    match /meet-schedules/{doc}         { allow read: if true; allow write: if false; }
    match /meet-results/{doc}           { allow read: if true; allow write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
